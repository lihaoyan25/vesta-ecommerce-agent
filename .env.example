# 数据库配置 -- MySQL
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_password
DATABASE_NAME=your_database_name

# 连接池配置 -- MySQL
POOL_SIZE=10
MAX_OVERFLOW=20
POOL_TIMEOUT=30
POOL_RECYCLE=3600

# 应用配置
APP_NAME=VESTA.OnlineMall
APP_DESCRIPTION=VESTA.OnlineMall, 基于FastAPI和Vue3开发的电商平台, 搭载AI智能客服
APP_VERSION=your_app_version
DEBUG=True
SECRET_KEY=please-change-me-to-a-random-secret

# JWT配置
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS配置
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=False
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# LLM配置-DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TOP_P=1.0
# 思考模式开关（True=开启深度思考, False=关闭；V4 系列服务端默认开启，程序会显式覆盖）
DEEPSEEK_THINKING=False

# ===== Docker 部署专用（docker-compose.yml 读取）=====
# MySQL root 密码（compose 首次启动自动建库建用户）
MYSQL_ROOT_PASSWORD=please-change-this-root-password
# 前端对外端口（宿主机端口）
FRONTEND_PORT=80
# 后端 uvicorn worker 数（2G 内存小服务器建议 1）
UVICORN_WORKERS=2